{
  "compilerOptions": {
    "target": "ES2024", "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": "src", "outDir": "dist/app", "strict": true, "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true, "types": ["node"], "lib": ["ES2024", "DOM"]
  },
  "include": ["src/main/**/*.ts", "src/main/**/*.cts", "src/core/**/*.ts", "src/shared.ts"]
}
