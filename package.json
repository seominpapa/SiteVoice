{
  "name": "voiceinput",
  "productName": "SiteVoice",
  "version": "0.2.9",
  "private": true,
  "description": "개인용 한국어 음성 입력",
  "author": "SiteVoice",
  "type": "module",
  "main": "dist/app/main/index.js",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "npm run native && npm run build && electron .",
    "native": "node native/build.mjs",
    "build": "tsc -p tsconfig.main.json && vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json",
    "test": "node --test tests/*.test.ts src/renderer/capture.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include='src/core/**' --test-coverage-lines=80 --test tests/core*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "package:mac": "node scripts/package.mjs mac arm64",
    "package:mac:intel": "node scripts/package.mjs mac x64",
    "package:win": "node scripts/package.mjs win x64"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "openai": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "45.4.1",
    "electron-builder": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  }
}
